# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-generate-with-python-c-"import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=postgres
DB_NAME=library
DB_USER=library
DB_PASSWORD=library_dev_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Email: console prints OTP / reset emails to the terminal (dev).
# For real SMTP use django.core.mail.backends.smtp.EmailBackend and fill the rest.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Library <no-reply@library.local>

# Production only (DEBUG=False behind HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False
